{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "apphosting.yaml",
      "**/.*",
      "**/node_modules/**",
      "server.ps1",
      "*.ps1"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "**/*.@(js|css)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "max-age=3600"
          }
        ]
      }
    ]
  },
  "apphosting": {
    "backendId": "decon-jee-app",
    "rootDir": "/",
    "ignore": [
      "node_modules",
      ".git",
      "firebase-debug.log",
      "firebase-debug.*.log",
      "server.ps1",
      "*.ps1"
    ]
  }
}
